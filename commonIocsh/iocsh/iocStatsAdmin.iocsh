#--################################################################################################
#--############### START of iocStatsAdmin.iocsh ##################################################
#-- IOC          : Record name prefix (records: $(IOC):ACCESS, $(IOC):HEARTBEAT, ...)
#-- devIocStats  : community devIocStats module install top (db under $(devIocStats)/db)
#--################################################################################################
#--#
#--# IOC is at most 21 characters: the record $(IOC):ALLOW_POSIX_THREAD_PRIORITY_SCHEDULING must
#--# not exceed 60 characters. A longer IOC fails with:
#--# Can't create stringin record '<IOC>:ALLOW_POSIX_THREAD_PRIORITY_SCHEDULING'
#--#
#--# Do not load this fragment together with linStat.iocsh, linStatHost.iocsh, or linStatProc.iocsh
#--# for the same IOC: both create records of the same names, and the second load fails.
#--#
#-
dbLoadRecords("$(devIocStats)/db/iocAdminSoft.db", "IOC=$(IOC)")
#-
#--############### END of iocStatsAdmin.iocsh ####################################################
#--################################################################################################
