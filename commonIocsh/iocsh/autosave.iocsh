#--################################################################################################
#--############### START of autosave.iocsh #######################################################
#-- IOC                 : Record name prefix; also per-IOC save/req subdirectory name (no colon)
#-- AS_TOP              : Autosave storage root (writable); files under $(AS_TOP)/$(IOC)/{save,req}
#-- AUTOSAVE            : autosave module install top (save_restoreStatus.db under $(AUTOSAVE)/db)
#-- INCOMPLETE          : [Default] 1    (Ok to save/restore save sets with missing values?)
#-- CA_RECONNECT        : [Default] 1    (Retry connecting to PVs whose initial connection failed?)
#-- DATED_BACKUP        : [Default] 1    (Save dated backup files?)
#-- NUM_SEQ             : [Default] 3    (Number of sequenced backup files to write)
#-- SEQ_PERIOD          : [Default] 300  (Time interval in seconds between sequenced backups)
#-- SETTINGS_FILES      : [Default] settings
#-- VALUES_FILES_PASS0  : [Default] values_pass0
#-- VALUES_FILES_PASS1  : [Default] values_pass1
#-- SETTINGS_PERIOD     : [Default] 5
#-- VALUES_PASS0_PERIOD : [Default] 5
#-- VALUES_PASS1_PERIOD : [Default] 10
#-- DEAD_SECONDS        : [Default] 5    (save_restoreStatus dead time, seconds)
#--################################################################################################
#-
set_savefile_path("$(AS_TOP)/$(IOC)", "/save")
set_requestfile_path("$(AS_TOP)/$(IOC)", "/req")
#-
#- If there is no path, create it
system("install -d $(AS_TOP)/$(IOC)/save")
system("install -d $(AS_TOP)/$(IOC)/req")
#-
#- iocBoot/iocas/save_restore.cmd
#-
save_restoreSet_status_prefix("$(IOC)-as:")
#-
#- Debug-output level
save_restoreSet_Debug(0)
#-
#- Ok to save/restore save sets with missing values (no CA connection to PV)?
save_restoreSet_IncompleteSetsOk($(INCOMPLETE=1))
#-
#- Tell save_restore to writed dated backup files.
save_restoreSet_DatedBackupFiles($(DATED_BACKUP=1))
#-
#- Tell save_restore to save sequence files.
#- save_restore to to maintain three copies of each *.sav file
save_restoreSet_NumSeqFiles($(NUM_SEQ=3))
#-
#- at 5 minute intervals
save_restoreSet_SeqPeriodInSeconds($(SEQ_PERIOD=300))
#-
#- should periodically retry connecting to PVs whose initial connection attempt failed
save_restoreSet_CAReconnect($(CA_RECONNECT=1))
#-
#- Time interval in seconds between forced save-file writes.  (-1 means forever).
#- This is intended to get save files written even if the normal trigger mechanism is broken.
save_restoreSet_CallbackTimeout(-1)
#-
#- pass0 : save files are to be restored before record initialization
set_pass0_restoreFile("$(SETTINGS_FILES=settings).sav")
set_pass0_restoreFile("$(VALUES_FILES_PASS0=values_pass0).sav")
#- pass1 : save files are to be restored after record initialization
set_pass1_restoreFile("$(SETTINGS_FILES=settings).sav")
set_pass1_restoreFile("$(VALUES_FILES_PASS1=values_pass1).sav")
#-
dbLoadRecords("$(AUTOSAVE)/db/save_restoreStatus.db", "P=$(IOC)-as:, DEAD_SECONDS=$(DEAD_SECONDS=5)")
#-
#- EPICS Base has the afterIocRunning function
afterIocRunning("makeAutosaveFileFromDbInfo('$(AS_TOP)/$(IOC)/req/$(SETTINGS_FILES=settings).req','autosaveFields')")
afterIocRunning("makeAutosaveFileFromDbInfo('$(AS_TOP)/$(IOC)/req/$(VALUES_FILES_PASS0=values_pass0).req','autosaveFields_pass0')")
afterIocRunning("makeAutosaveFileFromDbInfo('$(AS_TOP)/$(IOC)/req/$(VALUES_FILES_PASS1=values_pass1).req','autosaveFields_pass1')")
#-
#- We don't need PREFIX, because generated req files has the hard-code PV names from DBInfo : info tag
afterIocRunning("create_monitor_set('$(SETTINGS_FILES=settings).req','$(SETTINGS_PERIOD=5)')")
afterIocRunning("create_monitor_set('$(VALUES_FILES_PASS0=values_pass0).req','$(VALUES_PASS0_PERIOD=5)')")
afterIocRunning("create_monitor_set('$(VALUES_FILES_PASS1=values_pass1).req','$(VALUES_PASS1_PERIOD=10)')")
#-
#--############### END of autosave.iocsh #########################################################
#--################################################################################################
