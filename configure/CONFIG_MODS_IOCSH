## Installed-module entry mapping for the iocsh.bash loader metadata.
##
## tools/iocsh_metadata.bash derives each module's runtime entries by the
## default rule lib<name>.so with <name>.dbd, where <name> is the installed
## module name. A module whose installed names differ, or whose library or
## DBD list is empty, declares the exception here. The keys use the source
## module names, like <module>_DEPS and <module>_CONF_TYPE; the sequencer
## installs as seq. An explicitly empty value is a declaration: it marks a
## library-only or data-only module. Values are ordered, space-separated
## library stems and DBD file names. Metadata generation fails a module
## whose default-rule files are absent without an exception, rejects an
## expanded application DBD that redefines Base menus or record types, and
## rejects a DBD whose entries no selected or dependency library provides.

StreamDevice_IOCSH_LIBS:=stream
StreamDevice_IOCSH_DBDS:=stream.dbd

iocStats_IOCSH_LIBS:=devIocStats
iocStats_IOCSH_DBDS:=devIocStats.dbd

autosave_IOCSH_DBDS:=asSupport.dbd

caPutLog_IOCSH_DBDS:=caPutLog.dbd caPutJsonLog.dbd

calc_IOCSH_DBDS:=calcSupport.dbd

sscan_IOCSH_DBDS:=sscanSupport.dbd

mca_IOCSH_DBDS:=mcaSupport.dbd

