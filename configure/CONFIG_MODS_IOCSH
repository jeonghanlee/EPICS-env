## installs a Python package with its own executable.
QPC_IOCSH_LIBS:=
QPC_IOCSH_DBDS:=

pyDevSup_IOCSH_LIBS:=
pyDevSup_IOCSH_DBDS:=

VARS_EXCLUDES+=%_IOCSH_LIBS
VARS_EXCLUDES+=%_IOCSH_DBDS
