

.PHONY: install install.base install.modules install.commoniocsh src_version uninstall

install: install.base install.modules install.commoniocsh src_version


## commonIocsh iocsh fragment installation.
## Interim home: the fragments are held in the EPICS-env tree and installed
## directly under $(INSTALL_LOCATION_MODS)/commonIocsh/iocsh. An IOC sets
## IOCSH_TOP to $(INSTALL_LOCATION_MODS)/commonIocsh and loads a fragment as
## $(IOCSH_TOP)/iocsh/<fragment>.iocsh. No separate module clone or version
## symlink is created here; promotion to the public commonIocsh repository is
## a later step.
COMMONIOCSH_SRC_IOCSH:=$(TOP)/commonIocsh/iocsh
COMMONIOCSH_INSTALL_IOCSH:=$(INSTALL_LOCATION_MODS)/commonIocsh/iocsh

install.commoniocsh:
	$(QUIET)$(SUDO) mkdir -p $(COMMONIOCSH_INSTALL_IOCSH)
	$(QUIET)$(SUDO) $(INSTALL_DATA) $(COMMONIOCSH_SRC_IOCSH)/*.iocsh $(COMMONIOCSH_INSTALL_IOCSH)/


uninstall:
	$(QUIET)echo "Removing $(INSTALL_LOCATION_EPICS)..."
	$(QUIET)rm -rf $(INSTALL_LOCATION_EPICS)/


.PHONY: src_version src_clean 

src_version: FORCE
	$(QUIET)mkdir -p $(SITE_TEMPLATE_PATH)
	$(QUIET)echo "Timestamps : $$(date +%Y%m%d-%H%M%S)/YYYYMMDD-HHMMSS" > $(SITE_TEMPLATE_PATH)/.versions
	$(QUIET)echo "git version :$$(git rev-parse HEAD)" >> $(SITE_TEMPLATE_PATH)/.versions
	$(QUIET)$(INSTALL_DATA) -b $(SITE_TEMPLATE_PATH)/.versions  $(INSTALL_LOCATION_EPICS)/


src_clean:
	rm -rf $(SITE_TEMPLATE_PATH)/.versions
