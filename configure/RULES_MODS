.PHONY: init.modules clone.modules $(MOD_NAMES_VARS)

init.modules: clone.modules

.PHONY: remove.genmk clean.genmk reconf.modules show.genmk

reconf.modules: remove.genmk
	@make null

# Explicitly discard generated configuration for reconf.modules or clean.genmk.
# CONFIG_MODS handles automatic regeneration when effective module pins change.
remove.genmk:
	-rm -f $(TOP)/configure/*.mk

clean.genmk: remove.genmk

ifeq ($(wildcard $(TOP)/configure/MODULESGEN.mk),)
show.genmk: export MODS_GEN_OUTPUT = $(MODS_GEN_DISPLAY)
show.genmk:
	@set -o pipefail; { pending=YES; cache="$(TOP)/configure/MODULESGEN.mk"; \
	    for file in "$(TOP)/configure/"*.mk; do \
	        if ! test -e "$$file" && ! test -L "$$file"; then continue; fi; \
	        if test "$$pending" = YES && [[ "$$file" > "$$cache" ]]; then \
	            printf '%s' "$$MODS_GEN_OUTPUT"; pending=NO; \
	        fi; \
	        cat "$$file" || exit; \
	    done; \
	    if test "$$pending" = YES; then printf '%s' "$$MODS_GEN_OUTPUT"; fi; \
	  } | cat -bs
else
show.genmk:
	@cat -bs $(TOP)/configure/*.mk
endif

clone.modules: $(MOD_NAMES_VARS)

$(MOD_NAMES_VARS):
	@if test -d "$(TOP)/$(SRC_PATH_$(@))"; then \
		printf "Skip clone, because of the exist directory %s.\n" "$(SRC_PATH_$(@))"; \
	else \
		git clone --quiet $(SRC_GITURL_$(@)) $(SRC_PATH_$(@)); \
		cd $(SRC_PATH_$(@)) && git checkout $(SRC_TAG_$(@)); \
	fi

#	$(call gitclone,$(SRC_GITURL_$(@)),$(SRC_PATH_$(@)),$(SRC_TAG_$(@)))

distclean.modules:
	@for mod in $(SRC_RAW_PATH_MODULES) ; do \
		rm -rf $$mod ; \
 	done

include $(TOP)/configure/RULES_MODS_CONF_AUTO
include $(TOP)/configure/RULES_MODS_CONFIG
include $(TOP)/configure/RULES_MODS_BUILD
include $(TOP)/configure/RULES_MODS_AUDIT
