REVERT_PATCH = bash "$(TOP)/tools/revert_patch.bash"

# hash id is the full length
define make_base_p0_patch
	printf "\nCreating a p0 patch file in $(TOP)/patch\\n";
	cd $(SRC_PATH_BASE) && git diff --no-prefix > $(TOP)/patch/$(SRC_VER_BASE).base.p0.patch
endef

define base_patch_src
@for i in $(wildcard $(TOP)/patch/$(SRC_VER_BASE).base.p0.patch); do\
	printf "\nPatching %s with the file : %s\n" "$(SRC_PATH_BASE)" "$$i";\
	patch -d $(SRC_PATH_BASE) --ignore-whitespace -p0 < $$i;\
done
endef

define base_revert_patch_src
@for i in $(wildcard $(TOP)/patch/$(SRC_VER_BASE).base.p0.patch); do\
	$(REVERT_PATCH) "$(SRC_PATH_BASE)" "$$i" || exit 1;\
done
endef

# Upstream carry patches on the pinned base (EPICS-env #52). Files are named
# $(SRC_VER_BASE)-pr<NNNN>-<slug>.p0.patch for PR-merged fixes and
# $(SRC_VER_BASE)-<NN>-<sha7>-<slug>.p0.patch for direct commits with no PR
# (epics-base lands both), so the `-*` glob catches either; $(sort) gives the
# apply order and `sort -r` the exact reverse for revert. The version prefix auto-drops the whole set on a
# base bump (the glob finds nothing at the new version), forcing the
# base-bump re-examination. `|| exit 1` fails the target on any mid-stack
# miss instead of masking it behind a later success.
define base_pr_patch_src
@for i in $(sort $(wildcard $(TOP)/patch/$(SRC_VER_BASE)-*.p0.patch)); do\
	printf "\nPatching %s with the file : %s\n" "$(SRC_PATH_BASE)" "$$i";\
	patch -d $(SRC_PATH_BASE) --ignore-whitespace -p0 < $$i || exit 1;\
done
endef

define base_pr_revert_patch_src
@for i in $$(printf '%s\n' $(sort $(wildcard $(TOP)/patch/$(SRC_VER_BASE)-*.p0.patch)) | sort -r); do\
	$(REVERT_PATCH) --prerequisites "$(SRC_PATH_BASE)" "$$i" $(sort $(wildcard $(TOP)/patch/$(SRC_VER_BASE)-*.p0.patch)) || exit 1;\
done
endef

# Upstream-commit carry patches on the pinned pvxs (EPICS-env #53). pvxs
# lands maintainer commits, not PRs, so the carry unit is a commit and the
# filename sequence number supplies the order a hash cannot:
# $(SRC_VER_PVXS)-<NN>-<sha7>-<slug>.p0.patch. $(sort) yields ascending NN
# order for apply and `sort -r` the exact reverse for revert. The
# version-anchored glob ("1.5.2-*") cannot match the dormant
# patch/pvxs-1.3.1.p0.patch and auto-drops the whole set on a pvxs bump,
# forcing the joint re-examination recorded in docs/archive/pvxs-carry-1.3.0.md.
# `|| exit 1` fails the target on any mid-stack miss.
# --no-backup-if-mismatch: patches 02 and 04 apply at small offsets in
# tools/put.cpp (not-carried upstream commits precede them there); GNU
# patch's default backup-if-mismatch would leave a .orig that pvxs's own
# .gitignore hides from `git status`, so backups are disabled to keep the
# AC4 round trip provably clean.
define pvxs_commit_patch_src
@for i in $(sort $(wildcard $(TOP)/patch/$(SRC_VER_PVXS)-*.p0.patch)); do\
	printf "\nPatching %s with the file : %s\n" "$(SRC_PATH_PVXS)" "$$i";\
	patch -d $(SRC_PATH_PVXS) --ignore-whitespace --no-backup-if-mismatch -p0 < $$i || exit 1;\
done
endef

define pvxs_commit_revert_patch_src
@for i in $$(printf '%s\n' $(sort $(wildcard $(TOP)/patch/$(SRC_VER_PVXS)-*.p0.patch)) | sort -r); do\
	$(REVERT_PATCH) --no-backup-if-mismatch --prerequisites "$(SRC_PATH_PVXS)" "$$i" $(sort $(wildcard $(TOP)/patch/$(SRC_VER_PVXS)-*.p0.patch)) || exit 1;\
done
endef

