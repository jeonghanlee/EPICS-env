# Loader metadata for installed modules (configure/CONFIG_MODS_IOCSH).
# Each function takes the source module name, as sequencer or StreamDevice,
# and resolves the configuration key through SRC_NAME_<KEY>, the installed
# name through the sequencer-to-seq mapping, the declared dependencies
# through <module>_DEPS, and the entry exceptions through the file-origin
# <module>_IOCSH_LIBS and <module>_IOCSH_DBDS declarations. The macro name
# is the configuration key itself, the name every module RELEASE.local and
# commonIocsh fragment already uses. The expansions build command strings
# only; the tool runs inside recipes.
IOCSH_METADATA:=bash $(TOP)/tools/iocsh_metadata.bash
iocsh_key = $(strip $(foreach v,$(MOD_NAMES_VARS),$(if $(filter $(1),$(strip $(SRC_NAME_$(v)))),$(v))))
iocsh_installed = $(patsubst $(SEQ_SRC_NAME),seq,$(1))
iocsh_deps = $(foreach d,$(patsubst build.%,%,$(filter build.%,$($(1)_DEPS))),--dep $(call iocsh_installed,$(d))=$(SRC_VER_$(call iocsh_key,$(d))))
iocsh_libs = $(if $(filter file,$(origin $(1)_IOCSH_LIBS)),--libs '$($(1)_IOCSH_LIBS)',)
iocsh_dbds = $(if $(filter file,$(origin $(1)_IOCSH_DBDS)),--dbds '$($(1)_IOCSH_DBDS)',)
iocsh_common = --module $(call iocsh_installed,$(1)) --install $(INSTALL_LOCATION_$(call iocsh_key,$(1))) --version $(SRC_VER_$(call iocsh_key,$(1))) --tag $(SRC_TAG_$(call iocsh_key,$(1))) --base-version $(SRC_VER_BASE) --base $(INSTALL_LOCATION_BASE) --target $(1) $(call iocsh_deps,$(1))
iocsh_record = $(IOCSH_METADATA) record $(call iocsh_common,$(1)) --source $(TOP)/$(2)
iocsh_generate = $(IOCSH_METADATA) generate $(call iocsh_common,$(1)) --modules $(INSTALL_LOCATION_MODS) --pvxs $(INSTALL_LOCATION_PVXS) --macro $(call iocsh_key,$(1)) $(call iocsh_libs,$(1)) $(call iocsh_dbds,$(1))
iocsh_check = $(IOCSH_METADATA) check --module $(call iocsh_installed,$(1)) --install $(INSTALL_LOCATION_$(call iocsh_key,$(1))) --version $(SRC_VER_$(call iocsh_key,$(1))) --base-version $(SRC_VER_BASE) --base $(INSTALL_LOCATION_BASE)
VARS_EXCLUDES+=IOCSH_METADATA iocsh_%

# 1 : SRC_PATH
# 2 : rule name
# 3 : return vars
define a_rule_BUILDER
$(2).$(patsubst %-src,%, $(patsubst %/client, %, $(1))):
	@$$(SUDOBASH) "$$(DO_MAKE) -C $(1) $(2)"

$(3)+=$(2).$(patsubst %-src,%, $(patsubst %/client, %, $(1)))

endef

# 1 : SRC_PATH_MODULES
# 2 : rule name
# 3 : return vars
## For debugging purpose, please check buildrules_BUIDER
define rules_BUILDER
$(foreach dir, $(1), $(eval $(call a_rule_BUILDER,$(dir),$(2),$(3))))
endef


# 1 : SRC_PATH
# 2 : return vars
# 3 : dependent module build rule list (ORDER!!!)
## The EPICS build installs the module, so the successful build is recorded
## and the loader metadata is generated here, in dependency order.
## For debugging purpose, please check buildrules_BUIDER
define a_buildrule_BUILDER
build.$(patsubst %-src,%, $(patsubst %/client, %, $(1))): $($(3))
	@$$(SUDOBASH) "$$(DO_MAKE) -C $(1)"
	@$$(SUDOBASH) "$(call iocsh_record,$(patsubst %-src,%, $(patsubst %/client, %, $(1))),$(1))"
	@$$(SUDOBASH) "$(call iocsh_generate,$(patsubst %-src,%, $(patsubst %/client, %, $(1))))"

$(2)+=build.$(patsubst %-src,%, $(patsubst %/client, %, $(1)))

endef

# 1 : SRC_PATH
# 2 : return vars
## Individual module installation regenerates the loader metadata from the
## existing build record; a missing or stale record fails the installation.
define a_installrule_BUILDER
install.$(patsubst %-src,%, $(patsubst %/client, %, $(1))):
	@$$(SUDOBASH) "$$(DO_MAKE) -C $(1) install"
	@$$(SUDOBASH) "$(call iocsh_generate,$(patsubst %-src,%, $(patsubst %/client, %, $(1))))"

$(2)+=install.$(patsubst %-src,%, $(patsubst %/client, %, $(1)))

endef

# 1 : SRC_PATH_MODULES
# 2 : return vars
define installrules_BUILDER
$(foreach dir, $(1), $(eval $(call a_installrule_BUILDER,$(dir),$(2))))
endef

# 1 : SRC_PATH_MODULES
# 2 : return vars
# list of the dependent module build rule list (ORDER!!!)
#     we have to develop a list according to SRC_PATH_MODULES
#     SRC_PATH_DEPS ??
## For debugging purpose, please use info instead of eval
define buildrules_BUILDER
$(foreach dir, $(1), $(eval $(call a_buildrule_BUILDER,$(dir),$(2),$(patsubst %-src,%, $(patsubst %/client, %, $(dir)))_DEPS)))
endef



# 1 : SRC_PATH
# 2 : return vars
## The unversioned link is published only for an installed module whose
## loader metadata and recorded artifacts check out; a module that is not
## installed on this platform keeps the earlier behavior. An empty module
## directory is what uninstall.<module> leaves: it gets a notice and no
## link, so the remaining modules still get theirs.
define symlink_rule_BUILDER
symlink.$(patsubst %-src,%, $(patsubst %/client, %, $(1))): cleansymlink.$(patsubst %-src,%, $(patsubst %/client, %, $(1)))
	@if test -d $(INSTALL_LOCATION_$(call iocsh_key,$(patsubst %-src,%, $(patsubst %/client, %, $(1))))) && test -z "$$$$(ls -A $(INSTALL_LOCATION_$(call iocsh_key,$(patsubst %-src,%, $(patsubst %/client, %, $(1))))))"; then printf '%s\n' "symlink.$(patsubst %-src,%, $(patsubst %/client, %, $(1))): $(INSTALL_LOCATION_$(call iocsh_key,$(patsubst %-src,%, $(patsubst %/client, %, $(1))))) is empty, as after uninstall.$(patsubst %-src,%, $(patsubst %/client, %, $(1))); no link is created. Run make build.$(patsubst %-src,%, $(patsubst %/client, %, $(1))) to install the module again."; else { test ! -d $(INSTALL_LOCATION_$(call iocsh_key,$(patsubst %-src,%, $(patsubst %/client, %, $(1))))) || $(call iocsh_check,$(patsubst %-src,%, $(patsubst %/client, %, $(1)))) > /dev/null; } && cd $$(INSTALL_LOCATION_MODS) && $$(SUDO) ln -sf ./$$(filter $(patsubst $(SEQ_SRC_NAME),seq,$(patsubst %-src,%, $(patsubst %/client, %, $(1))))-%, $$(notdir $$(MODS_INSTALL_LOCATIONS))) ./$(patsubst $(SEQ_SRC_NAME),seq,$(patsubst %-src,%, $(patsubst %/client, %, $(1)))); fi

$(2)+=symlink.$(patsubst %-src,%, $(patsubst %/client, %, $(1)))

endef

# 1 : SRC_PATH_MODULES
# 3 : return vars
define symlinks_BUILDER
$(foreach dir, $(1), $(eval $(call symlink_rule_BUILDER,$(dir),$(2))))
endef



