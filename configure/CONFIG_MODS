# One renderer supplies both in-memory query variables and the persistent cache.
MODS_GEN_INPUTS:=$(foreach v,$(sort $(MOD_NAMES_VARS)),$(v)=$(strip $(SRC_NAME_$(v))):$(strip $(SRC_TAG_$(v))):$(strip $(SRC_VER_$(v))):$(strip $(SRC_BASE_$(v))))
define MODS_GEN_NEWLINE


endef
define MODS_GEN_CONTENT
MODS_GEN_SAVED_INPUTS:=$(MODS_GEN_INPUTS)
$(subst $(MODS_GEN_NEWLINE) ,$(MODS_GEN_NEWLINE),$(foreach v,$(MOD_NAMES_VARS),SRC_GITURL_$(v):=$(or $(strip $(SRC_BASE_$(v))),$(SRC_URL_EPICSMODULES))/$(strip $(SRC_NAME_$(v)))$(MODS_GEN_NEWLINE))\
$(foreach v,$(MOD_NAMES_VARS),INSTALL_LOCATION_$(v):=$$(INSTALL_LOCATION_MODS)/$(strip $(patsubst $(SEQ_SRC_NAME), seq, $(SRC_NAME_$(v)))-$(SRC_VER_$(v)))$(MODS_GEN_NEWLINE))\
$(foreach v,$(MOD_NAMES_VARS),SRC_PATH_$(v):=$(SRC_NAME_$(v))-src$(MODS_GEN_NEWLINE)))
endef
define MODS_GEN_DISPLAY
# Generated at $(shell date +%Y%m%d-%H%M%S)
$(MODS_GEN_CONTENT)
endef

ifeq ($(QUERY_ONLY),YES)
$(eval $(MODS_GEN_CONTENT))
else
include $(TOP)/configure/MODULESGEN.mk

# Effective pins include local override removal; tracked configuration also
# invalidates the cache. Unchanged action invocations preserve its mtime.
ifneq ($(MODS_GEN_INPUTS),$(MODS_GEN_SAVED_INPUTS))
.PHONY: force.modulesgen
force.modulesgen:
$(TOP)/configure/MODULESGEN.mk: force.modulesgen
endif

$(TOP)/configure/MODULESGEN.mk: $(TOP)/configure/RELEASE $(TOP)/configure/CONFIG_SITE
	$(file >$@,$(MODS_GEN_DISPLAY))
	@:
endif

# Only file-origin module source paths enter the cleanup list. Command-line
# overrides and unrelated SRC_PATH_* variables remain outside that list.
# Queries derive these paths in memory; actions load the generated cache.
SRC_RAW_PATH_MODULES:=$(foreach v,$(MOD_NAMES_VARS),$(if $(filter file,$(origin SRC_PATH_$(v))),$(SRC_PATH_$(v))))
## recsync (RecCaster) EPICS module is located in the different path
SRC_PATH_MODULES:=$(patsubst recsync-src,recsync-src/client,$(SRC_RAW_PATH_MODULES))

#
# Installation cleanup uses only module-derived, file-origin values. Other
# INSTALL_LOCATION_* variables and command-line overrides cannot enter it.
MODS_INSTALL_LOCATIONS_VARS:=$(foreach v,$(MOD_NAMES_VARS),INSTALL_LOCATION_$(v))
MODS_INSTALL_LOCATIONS:=$(foreach v, $(MODS_INSTALL_LOCATIONS_VARS), $(if $(filter file,$(origin $(v))),$($(v))))
MODS_INSTALL_LOCATIONS_SYMLINKS:=$(foreach v, $(MOD_NAMES), $(addsuffix /$(v), $(INSTALL_LOCATION_MODS)))

PYTHON_CMD=$(shell command -v python3)

ifeq (, $(PYTHON_CMD))
    $(error "We cannot find the python3 in your installation system. Please check Python 3 first.")
endif

include $(TOP)/configure/CONFIG_MODS_DEPS
include $(TOP)/configure/CONFIG_MODS_IOCSH

VARS_EXCLUDES+=SRC_RAW_PATH_MODULES
VARS_EXCLUDES+=MODS_GEN_INPUTS MODS_GEN_SAVED_INPUTS MODS_GEN_NEWLINE MODS_GEN_CONTENT MODS_GEN_DISPLAY MODS_GEN_OUTPUT
