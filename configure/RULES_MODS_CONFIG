## areaDetector: ADCore and its three detectors, configured as the former
## EPICS-env-support repository did. Each module takes EPICS_BASE and its
## dependency paths from a RELEASE.local, and the detectors build against the
## installed ADCore cfg/ files, so the module Makefiles name cfg instead of
## ADApp. ADCore, ADSimDetector, and ADGenICam read CONFIG_SITE.local; the
## CONFIG_SITE of ADVimba does not, and its RELEASE redefines ADGENICAM after it
## reads RELEASE.local, so ADVimba settings go into RELEASE and CONFIG_SITE.
conf.ADCore:
	@echo "EPICS_BASE:=$(INSTALL_LOCATION_BASE)"             > $(TOP)/$(SRC_PATH_ADCORE)/configure/RELEASE.local
	@echo "ASYN:=$(INSTALL_LOCATION_ASYN)"                  >> $(TOP)/$(SRC_PATH_ADCORE)/configure/RELEASE.local
	@echo "PVXS:=$(INSTALL_LOCATION_PVXS)"                  >> $(TOP)/$(SRC_PATH_ADCORE)/configure/RELEASE.local
	@echo "INSTALL_LOCATION:=$(INSTALL_LOCATION_ADCORE)"     > $(TOP)/$(SRC_PATH_ADCORE)/configure/CONFIG_SITE.local
	@echo "CHECK_RELEASE = NO"                              >> $(TOP)/$(SRC_PATH_ADCORE)/configure/CONFIG_SITE.local
	@echo "PROD_LDFLAGS += -Wl,--enable-new-dtags"          >> $(TOP)/$(SRC_PATH_ADCORE)/configure/CONFIG_SITE.local
	@echo "WITH_PVA = YES"                                  >> $(TOP)/$(SRC_PATH_ADCORE)/configure/CONFIG_SITE.local
	@echo "WITH_QSRV = YES"                                 >> $(TOP)/$(SRC_PATH_ADCORE)/configure/CONFIG_SITE.local
	@echo "WITH_PVXS = YES"                                 >> $(TOP)/$(SRC_PATH_ADCORE)/configure/CONFIG_SITE.local
	@echo "WITH_JASON = YES"                                >> $(TOP)/$(SRC_PATH_ADCORE)/configure/CONFIG_SITE.local
	@echo "WITH_HDF5 = YES"                                 >> $(TOP)/$(SRC_PATH_ADCORE)/configure/CONFIG_SITE.local
	@echo "WITH_JPEG = YES"                                 >> $(TOP)/$(SRC_PATH_ADCORE)/configure/CONFIG_SITE.local
	@echo "WITH_ZLIB = YES"                                 >> $(TOP)/$(SRC_PATH_ADCORE)/configure/CONFIG_SITE.local
	@echo "USR_CPPFLAGS += `pkg-config --cflags libxml-2.0`" >> $(TOP)/$(SRC_PATH_ADCORE)/configure/CONFIG_SITE.local
	@echo "USR_LDFLAGS += `pkg-config --libs libxml-2.0`"   >> $(TOP)/$(SRC_PATH_ADCORE)/configure/CONFIG_SITE.local
ifeq ($(OS_NAME), $(filter $(OS_NAME), debian ubuntu))
	@echo "USR_CPPFLAGS += `pkg-config --cflags hdf5`"      >> $(TOP)/$(SRC_PATH_ADCORE)/configure/CONFIG_SITE.local
	@echo "USR_LDFLAGS += `pkg-config --libs hdf5`"         >> $(TOP)/$(SRC_PATH_ADCORE)/configure/CONFIG_SITE.local
endif

conf.ADCore.show: conf.release.modules.show
	cat -b $(TOP)/$(SRC_PATH_ADCORE)/configure/RELEASE.local
	cat -b $(TOP)/$(SRC_PATH_ADCORE)/configure/CONFIG_SITE.local

