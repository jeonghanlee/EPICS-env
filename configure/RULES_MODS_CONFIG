conf.opcua:
	@echo "INSTALL_LOCATION:=$(INSTALL_LOCATION_OPCUA)"       > $(TOP)/$(SRC_PATH_OPCUA)/configure/CONFIG_SITE.local
	@echo "USR_CXXFLAGS_Linux += -std=c++11"                 >> $(TOP)/$(SRC_PATH_OPCUA)/configure/CONFIG_SITE.local
	@echo "OPEN62541 = $(OPEN62541_PATH)"                    >> $(TOP)/$(SRC_PATH_OPCUA)/configure/CONFIG_SITE.local
	@echo "OPEN62541_DEPLOY_MODE = PROVIDED"                 >> $(TOP)/$(SRC_PATH_OPCUA)/configure/CONFIG_SITE.local
	@echo "OPEN62541_LIB_DIR = \$$(OPEN62541)/lib"           >> $(TOP)/$(SRC_PATH_OPCUA)/configure/CONFIG_SITE.local
	@echo "OPEN62541_SHRLIB_DIR = \$$(OPEN62541_LIB_DIR)"    >> $(TOP)/$(SRC_PATH_OPCUA)/configure/CONFIG_SITE.local
	@echo "OPEN62541_USE_CRYPTO = YES"                       >> $(TOP)/$(SRC_PATH_OPCUA)/configure/CONFIG_SITE.local
	@echo "OPEN62541_USE_XMLPARSER = YES"                    >> $(TOP)/$(SRC_PATH_OPCUA)/configure/CONFIG_SITE.local
# The installed CONFIG_OPCUA carries OPEN62541_PATH as given, while the build reads the installed
# file back through the include below and resolves OPEN62541 itself; the expansion flag keeps the
# installed text identical for every installation.
	@echo "CONFIG_OPCUA_EXPANDFLAGS = -D OPEN62541=$(OPEN62541_PATH)" >> $(TOP)/$(SRC_PATH_OPCUA)/configure/CONFIG_SITE.local
	@echo "-include \$$(INSTALL_LOCATION)/cfg/CONFIG_OPCUA"  >> $(TOP)/$(SRC_PATH_OPCUA)/configure/CONFIG_SITE.local

conf.opcua.show: conf.release.modules.show
	cat -b $(TOP)/$(SRC_PATH_OPCUA)/configure/CONFIG_SITE.local
