# GCC 15 defaults the C dialect to C23, where an unprototyped declarator
# means (void) and K&R definitions leave the language. Each module below
# fails on its own pre-C23 C and builds with the C17 bridge on such
# toolchains until upstream modernizes it (survey record in issue #29):
#   sequencer    support/lemon/lemon.c K&R definitions
#   iocStats     devIocStatsAnalog.c DEVSUPFUN DSET initializers
#   calc         transformRecord.c DEVSUPFUN DSET initializers
#   busy         busyRecord.c unprototyped DSET member calls
#   StreamDevice devaoStream.c DEVSUPFUN DSET initializers
#   lua          devLuaAi.c DEVSUPFUN DSET initializers
#   std          epidRecord.c DEVSUPFUN DSET initializers
#   scaler       scalerRecord.c unprototyped DSET member calls
#   mca          mcaRecord.c unprototyped DSET member calls
# Extend the OS condition as more GCC 15 era targets join the matrix.
MODS_C17_BRIDGE :=
ifeq ($(OS_NAME)-$(firstword $(subst ., ,$(OS_VERSION))),ubuntu-26)
MODS_C17_BRIDGE := -std=gnu17
endif

iocStats_CONF_RELEASE_LINES:=MAKE_TEST_IOC_APP=NO
iocStats_CONF_SITE_LINES:=$(if $(MODS_C17_BRIDGE),USR_CFLAGS += $(MODS_C17_BRIDGE))
MCoreUtils_CONF_PLATFORM:=Linux
retools_CONF_SITE_LINES:=USR_CPPFLAGS += -DUSE_TYPED_RSET

# These run at parse time, so a generated configure/MODULESGEN.mk left over
# from an earlier module set (a rename such as feed -> feed-core, or any
# RELEASE module change) reports here before make can regenerate it. The
# hint names the recovery: MODULESGEN.mk is generated and gitignored, so
# removing it costs nothing (issue #48). The hint says plain 'rm', not a
# make target: this error fires at parse time, so every make invocation —
# including distclean.modulesgen — dies before any recipe can run.
MODS_GEN_STALE_HINT = (if the module set just changed, the generated configure/MODULESGEN.mk may be stale: remove it with 'rm configure/MODULESGEN.mk' and retry)

define validate_conf_type
$(if $($(1)_CONF_TYPE),,$(error Missing $(1)_CONF_TYPE declaration $(MODS_GEN_STALE_HINT)))
$(if $(filter auto custom,$($(1)_CONF_TYPE)),,$(error Invalid $(1)_CONF_TYPE value: $($(1)_CONF_TYPE) $(MODS_GEN_STALE_HINT)))
endef

$(foreach module, $(MOD_CONF_TYPE_MODULES), $(call validate_conf_type,$(module)))

VARS_EXCLUDES+=MOD_CONF_TYPE_MODULES
