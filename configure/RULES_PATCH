.PHONY: patch.pvxs.commit.apply patch.pvxs.commit.revert

## Apply the upstream-commit carry patches on the pinned pvxs (EPICS-env
## #53), ascending sequence order; revert in the exact reverse order. The
## commented patch.pvxs.* block above is dormant history, intentionally
## left untouched.
patch.pvxs.commit.apply:
	$(QUIET) $(call pvxs_commit_patch_src)

patch.pvxs.commit.revert:
	$(QUIET) $(call pvxs_commit_revert_patch_src)



.PHONY: patch.measComp.make patch.measComp.apply patch.measComp.revert

## measComp cfg carry (EPICS-env #51): install cfg/CONFIG_MEASCOMP so a
## downstream consumer that names MEASCOMP inherits ULDAQ_DIR without
## declaring it. New file measCompApp/src/CONFIG_MEASCOMP + Makefile CFG.
patch.measComp.make:
	$(QUIET) mkdir -p $(TOP)/patch
	$(QUIET) cd $(SRC_PATH_MEASCOMP) && git add -N measCompApp/src/CONFIG_MEASCOMP && git diff --no-prefix -- measCompApp/src/CONFIG_MEASCOMP measCompApp/src/Makefile > $(TOP)/patch/measComp-CONFIG_MEASCOMP.p0.patch

patch.measComp.apply:
	$(QUIET) printf "\nPatching %s with the file : %s\n" "$(SRC_PATH_MEASCOMP)" "measComp-CONFIG_MEASCOMP.p0.patch";
	$(QUIET) patch -d $(SRC_PATH_MEASCOMP) --ignore-whitespace -p0 < $(TOP)/patch/measComp-CONFIG_MEASCOMP.p0.patch;

patch.measComp.revert:
	$(QUIET) printf "\nReverting %s with the file : %s\n" "$(SRC_PATH_MEASCOMP)" "measComp-CONFIG_MEASCOMP.p0.patch";
	$(QUIET) patch -R -d $(SRC_PATH_MEASCOMP) --ignore-whitespace -p0 < $(TOP)/patch/measComp-CONFIG_MEASCOMP.p0.patch;

.PHONY: patch.StreamDevice.make patch.StreamDevice.apply patch.StreamDevice.revert

## StreamDevice vxi11 reconcile (M34, asyn R4-46): R4-46 gates the vxi11
## driver behind DRV_VXI11=YES, which the site does not enable, so the
## streamApp example's asynRegistrars.dbd must not register vxi11.
patch.StreamDevice.make:
	$(QUIET) mkdir -p $(TOP)/patch
	$(QUIET) cd $(SRC_PATH_STREAM) && git diff --no-prefix -- streamApp/asynRegistrars.dbd > $(TOP)/patch/StreamDevice-no-vxi11.p0.patch

patch.StreamDevice.apply:
	$(QUIET) printf "\nPatching %s with the file : %s\n" "$(SRC_PATH_STREAM)" "StreamDevice-no-vxi11.p0.patch";
	$(QUIET) patch -d $(SRC_PATH_STREAM) --ignore-whitespace -p0 < $(TOP)/patch/StreamDevice-no-vxi11.p0.patch;

patch.StreamDevice.revert:
	$(QUIET) printf "\nReverting %s with the file : %s\n" "$(SRC_PATH_STREAM)" "StreamDevice-no-vxi11.p0.patch";
	$(QUIET) patch -R -d $(SRC_PATH_STREAM) --ignore-whitespace -p0 < $(TOP)/patch/StreamDevice-no-vxi11.p0.patch;
