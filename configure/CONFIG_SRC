GIT_SSH_COMMAND := ssh -o ForwardX11=no -x
export GIT_SSH_COMMAND

INSTALL:= install
INSTALL_PROGRAM:=$(INSTALL)
INSTALL_DATA:=$(INSTALL) -m 644

ifeq ($(UNAME_S),Darwin)
OS_VERSION:=$(strip $(shell sw_vers -productVersion))
OS_NAME:=$(strip $(shell sw_vers -productName))
endif
ifeq ($(UNAME_S),Linux)
# Functional Logic: Zero-fork extraction utilizing POSIX standard shell sourcing.
# Technical Constraint: /etc/os-release is natively sourceable, bypassing external binaries.
OS_VERSION:=$(strip $(shell . /etc/os-release 2>/dev/null && printf "%s" "$$VERSION_ID"))
OS_NAME:=$(strip $(shell . /etc/os-release 2>/dev/null && printf "%s" "$$ID"))
endif

ifeq ($(strip $(OS_VERSION)),)
OS_VERSION:=unknownVER
endif

ifeq ($(strip $(OS_NAME)),)
OS_NAME:=unknownOS
endif


# We remove the default epics folder name.
#
#ifneq (,$(findstring /epics, $(INSTALL_LOCATION)))
    INSTALL_LOCATION_CHECK:=$(INSTALL_LOCATION)
#else
#    INSTALL_LOCATION_CHECK:=$(INSTALL_LOCATION)/epics
#endif

# Existing directories require only parent traversal to be recognized. Missing
# components require search and create access at the nearest existing ancestor.
# Action invocations retain the actual creation probe, including mount failures.
ifeq ($(QUERY_ONLY),YES)
SUDO_INFO := $(shell path="$(INSTALL_LOCATION_CHECK)"; result=0; \
    if test -z "$$path"; then result=1; \
    else \
        while ! test -d "$$path"; do \
            if test -e "$$path" || test -L "$$path"; then result=1; break; fi; \
            parent="$${path%/*}"; \
            if test "$$parent" = "$$path"; then parent=.; elif test -z "$$parent"; then parent=/; fi; \
            path="$$parent"; \
            if test -d "$$path"; then \
                if ! test -w "$$path" || ! test -x "$$path"; then result=1; fi; \
            fi; \
        done; \
    fi; printf '%s' "$$result")
else
SUDO_INFO := $(shell mkdir -p $(INSTALL_LOCATION_CHECK) 1>&2 2> /dev/null; echo $$?)
endif
SUDO_CMD  := $(shell which sudo)

ifeq "$(SUDO_INFO)" "1"
SUDO = $(SUDO_CMD)
SUDOBASH := $(SUDO) -E bash -c
else
SUDO :=
SUDOBASH = bash -c
endif


DO_MAKE=make LINKER_USE_RPATH=$(LINKER_USE_RPATH) LINKER_ORIGIN_ROOT="$(INSTALL_LOCATION_EPICS)"

PATH_NAME_EPICSVERS:=$(strip $(SRC_VER_BASE))

PATH_NAME_BASE:=base
PATH_NAME_MODULES:=modules

INSTALL_LOCATION_VER:=$(strip $(INSTALL_LOCATION_CHECK))/$(ENV_RELEASE_VERS)
INSTALL_LOCATION_EPICS:=$(INSTALL_LOCATION_VER)/$(OS_NAME)-$(OS_VERSION)/$(PATH_NAME_EPICSVERS)
INSTALL_LOCATION_BASE:=$(INSTALL_LOCATION_EPICS)/$(PATH_NAME_BASE)
INSTALL_LOCATION_MODS:=$(INSTALL_LOCATION_EPICS)/$(PATH_NAME_MODULES)

